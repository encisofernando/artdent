{
  "name": "artdent-print-server",
  "version": "1.0.0",
  "description": "Servidor de Impresion ArtDent",
  "main": "main.js",
  "author": "ArtDent",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.artdent.print",
    "productName": "ArtDentPrint",
    "win": {
      "target": [
        "msi"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "ArtDent Print Service"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "electron-settings": "^4.0.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  }
}
APP_NAME=ArtDentAPI
APP_ENV=production
APP_KEY=base64:JCbmLnUwcutFovSkyzBQ1wFWLCLglFze8pfvSvTRpwk=
APP_DEBUG=false
APP_URL=https://api.artdent.com.ar
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Argentina/Buenos_Aires

LOG_CHANNEL=stack
LOG_LEVEL=error

# Frontend URL (usado en config/cors.php y emails)
FRONTEND_URL=https://pos.artdent.com.ar

# ── Base de Datos ──────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artdent_lab
DB_USERNAME=artdent_fer
DB_PASSWORD=ArtDent_2025
DEFAULT_COMPANY_ID=2

# ── E-commerce ─────────────────────────────────────────────────────────────────
ECOMMERCE_COMPANY_ID=2
ECOMMERCE_WAREHOUSE_ID=1
DEFAULT_B2B_DISCOUNT_PERCENT=0

# ── Cache / Queue ──────────────────────────────────────────────────────────────
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.artdent.com.ar

# ── Sanctum ────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=pos.artdent.com.ar,shop.artdent.com.ar

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://pos.artdent.com.ar,https://shop.artdent.com.ar

# ── AFIP / ARCA ────────────────────────────────────────────────────────────────
AFIP_MODE=homo
AFIP_CUIT=20402155168
AFIP_SERVICE=wsfe
AFIP_ALIAS=AdmGlobal
AFIP_CERT_PKEY_PASS=
AFIP_CERT=storage/app/afip/homologacion/Certificado.crt
AFIP_KEY=storage/app/afip/homologacion/ClavePrivada.pem
AFIP_CAINFO=storage/app/afip/homologacion/afip_homo_cacert.pem
AFIP_TRA_XML=${AFIP_CERTS_PATH}/tra.xml
AFIP_TRA_CMS=${AFIP_CERTS_PATH}/tra.cms
AFIP_WSAA_URL="https://wsaahomo.afip.gov.ar/ws/services/LoginCms"
AFIP_WSFE_URL="https://wswhomo.afip.gov.ar/wsfev1/service.asmx"
AFIP_POS=3
AFIP_QR_BASE="https://www.afip.gob.ar/fe/qr/?p="
AFIP_CERT_PATH=storage/app/afip/homologacion/Certificado.crt
AFIP_KEY_PATH=storage/app/afip/homologacion/ClavePrivada.pem
AFIP_DEBUG=0


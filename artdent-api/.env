APP_NAME=ArtDentAPI
APP_ENV=local
APP_KEY=base64:JCbmLnUwcutFovSkyzBQ1wFWLCLglFze8pfvSvTRpwk=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Argentina/Buenos_Aires

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Frontend URL
FRONTEND_URL=https://shop.artdent.com.ar

# ── Base de Datos ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artdent_lab
DB_USERNAME=artdent_fer
DB_PASSWORD=ArtDent_2025
DEFAULT_COMPANY_ID=2

# ── E-commerce ──
ECOMMERCE_COMPANY_ID=2
ECOMMERCE_WAREHOUSE_ID=1
DEFAULT_COMPANY_ID=2
DEFAULT_B2B_DISCOUNT_PERCENT=0

# Cache/session (file-based to avoid DB cache table)
CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# CORS / Sanctum (si usas SPA)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,shop.artdent.com.ar,localhost:5175,127.0.0.1:5175,pos.artdent.com.ar
SESSION_DOMAIN=.artdent.com.ar

AFIP_MODE=homo
AFIP_CUIT=20402155168            # tu CUIT sin guiones
AFIP_SERVICE=wsfe                # Servicio a autorizar (WSFE)
AFIP_ALIAS=AdmGlobal             # el alias que usarás en AFIP
AFIP_CERT_PKEY_PASS=             # si tu clave privada tiene passphrase

# Rutas relativas a la raíz del proyecto (base_path)
AFIP_CERT=storage/app/afip/homologacion/Certificado.crt
AFIP_KEY=storage/app/afip/homologacion/ClavePrivada.pem
AFIP_CAINFO=storage/app/afip/homologacion/afip_homo_cacert.pem

AFIP_TRA_XML=${AFIP_CERTS_PATH}/tra.xml
AFIP_TRA_CMS=${AFIP_CERTS_PATH}/tra.cms
AFIP_WSAA_URL="https://wsaahomo.afip.gov.ar/ws/services/LoginCms"
AFIP_WSFE_URL="https://wswhomo.afip.gov.ar/wsfev1/service.asmx"
AFIP_POS=3
AFIP_QR_BASE="https://www.afip.gob.ar/fe/qr/?p="

# Compat por si el código usa *_PATH
AFIP_CERT_PATH=storage/app/afip/homologacion/Certificado.crt
AFIP_KEY_PATH=storage/app/afip/homologacion/ClavePrivada.pem
AFIP_DEBUG=1

# ── Email (SMTP) ──
MAIL_MAILER=smtp
MAIL_HOST=vps-4492849-x.dattaweb.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@artdent.com.ar
MAIL_PASSWORD=ArtDent_2025
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@artdent.com.ar
MAIL_FROM_NAME="${APP_NAME}"

# opcional
MAIL_EHLO_DOMAIN=artdent.com.ar
MAIL_TIMEOUT=15

# ── Pasarelas de Pago ──

# Mercado Pago
MP_PUBLIC_KEY=TEST-xxxxx-xxxxx-xxxxx-xxxxx
MP_ACCESS_TOKEN=TEST-xxxxx-xxxxx-xxxxx-xxxxx
MP_PRODUCTION=false
MP_WEBHOOK_SECRET=your_webhook_secret_here

# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ── Analytics y Tracking ──

# Google Analytics 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=xxxxx

# Facebook/Meta Pixel
FB_PIXEL_ID=1234567890
FB_ACCESS_TOKEN=xxxxx
FB_APP_ID=xxxxx
FB_APP_SECRET=xxxxx

# Hotjar
HOTJAR_SITE_ID=1234567

# Google Maps
GOOGLE_MAPS_API_KEY=xxxxx

# ── Chat y Soporte ──

# Tawk.to (Live Chat)
TAWK_PROPERTY_ID=xxxxx
TAWK_WIDGET_ID=xxxxx

# ── Email Marketing ──

# SendGrid
SENDGRID_API_KEY=SG.xxxxx

# Mailchimp
MAILCHIMP_API_KEY=xxxxx-us1
MAILCHIMP_LIST_ID=xxxxx
MAILCHIMP_SERVER_PREFIX=us1

# ── Push Notifications ──

# Firebase Cloud Messaging
FIREBASE_SERVER_KEY=xxxxx
FIREBASE_SENDER_ID=xxxxx
FIREBASE_API_KEY=xxxxx
FIREBASE_PROJECT_ID=artdent-ecommerce

# ── Almacenamiento de Archivos ──

# AWS S3
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=artdent-storage
AWS_URL=
AWS_ENDPOINT=

# Cloudinary (alternativa para imágenes)
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# ── Búsqueda Avanzada ──

# Algolia
ALGOLIA_APP_ID=xxxxx
ALGOLIA_API_KEY=xxxxx
ALGOLIA_ADMIN_KEY=xxxxx
ALGOLIA_INDEX=products

# ── SMS ──

# Twilio
TWILIO_SID=ACxxxxx
TWILIO_TOKEN=xxxxx
TWILIO_FROM=+1234567890

# ── Envíos (Argentina) ──

# Andreani
ANDREANI_API_KEY=xxxxx
ANDREANI_CLIENT_ID=xxxxx

# Correo Argentino
CORREO_ARGENTINO_API_KEY=xxxxx

# OCA
OCA_API_KEY=xxxxx

# ── Redis (Cache y Queues) ──
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Queue ──
QUEUE_CONNECTION=redis
# O usar 'database' para desarrollo sin Redis

# ── Session ──
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Cache ──
CACHE_DRIVER=file
# O usar 'redis' en producción

# ── Broadcasting ──
BROADCAST_DRIVER=log
# O usar 'pusher' para websockets

# Pusher (Real-time)
PUSHER_APP_ID=xxxxx
PUSHER_APP_KEY=xxxxx
PUSHER_APP_SECRET=xxxxx
PUSHER_APP_CLUSTER=mt1

# ── Logs ──
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Sanctum ──
SANCTUM_STATEFUL_DOMAINS=shop.artdent.com.ar,pos.artdent.com.ar

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://shop.artdent.com.ar,https://pos.artdent.com.ar

# ── Rate Limiting ──
# Requests por minuto para API
API_RATE_LIMIT=60

# ── PWA ──
PWA_NAME="${APP_NAME} E-Commerce"
PWA_SHORT_NAME="${APP_NAME}"
PWA_THEME_COLOR=#0066CC
PWA_BACKGROUND_COLOR=#FFFFFF

# ── Debugging y Testing ──
# SOLO EN DESARROLLO
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# ── Backup ──
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=admin@artdent.com.ar

# ── SEO ──
SEO_DEFAULT_TITLE="ARTDENT - Productos Dentales Profesionales"
SEO_DEFAULT_DESCRIPTION="Tu sonrisa, es nuestra prioridad. Productos dentales de alta calidad."
SEO_KEYWORDS="artdent,dental,odontología,productos dentales,argentina"

# ── Social Media ──
FACEBOOK_URL=https://www.facebook.com/artdent
INSTAGRAM_URL=https://www.instagram.com/artdent
LINKEDIN_URL=https://www.linkedin.com/company/artdent
TWITTER_URL=https://twitter.com/artdent

# ── Cron Jobs ──
# Debe configurarse en crontab:
# * * * * * cd /www/wwwroot/api.artdent.com.ar && php artisan schedule:run >> /dev/null 2>&1

# ── Performance ──
OCTANE_SERVER=roadrunner
# O 'swoole' si usas Swoole


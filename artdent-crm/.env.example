APP_NAME="ArtDent CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.artdent.com.ar
ECOMMERCE_URL=https://shop.artdent.com.ar

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artdent_admin
DB_USERNAME=fer_artdent_fer
DB_PASSWORD=ArtDent_2025
CENTRAL_DB_HOST=${DB_HOST}
CENTRAL_DB_PORT=${DB_PORT}
CENTRAL_DB_DATABASE=${DB_DATABASE}
CENTRAL_DB_USERNAME=${DB_USERNAME}
CENTRAL_DB_PASSWORD=${DB_PASSWORD}
TENANT_DB_HOST=${DB_HOST}
TENANT_DB_PORT=${DB_PORT}
TENANT_DB_DATABASE=artdent_dev
TENANT_DB_USERNAME=${DB_USERNAME}
TENANT_DB_PASSWORD=${DB_PASSWORD}
TENANCY_DB_CONNECTION=central
TENANCY_TEMPLATE_TENANT_CONNECTION=mysql
TENANCY_DB_PREFIX=artdent_
TENANCY_DB_SUFFIX=

# ── Modo de despliegue del CRM ────────────────────────────────────────────────
# multi_tenant: usa base central + tenant databases
# owner: instancia standalone con su propia DB, sin suscripción ni cobros
CRM_MODE=multi_tenant
CRM_BILLING_ENABLED=true
CRM_OWNER_TENANT_ID=artdent
CRM_OWNER_TENANT_NAME="ArtDent"
CRM_OWNER_TENANT_EMAIL=
CRM_OWNER_TENANT_PLAN=owner
CRM_OWNER_TENANT_STATUS=active
CRM_OWNER_TENANT_TRIAL_ENDS_AT=
CRM_OWNER_TENANT_ACTIVATED_AT=

# ── Sesión ────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_CONNECTION=central
SESSION_COOKIE=artdent_crm_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.artdent.com.ar

# ── Colas y caché ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
DB_CACHE_CONNECTION=central

# ── Reverb (WebSockets / tiempo real) ───────────────────────────────────────
# Poner BROADCAST_CONNECTION=reverb arriba para activarlo. Las mismas
# credenciales REVERB_* deben usarse en artdent-admin (comparten un único
# proceso `reverb:start` en el VPS) — ver artdent-crm/routes/channels.php.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# En local, bootstrap.js no conecta Echo si REVERB_HOST es localhost, salvo
# que se fuerce explícitamente (evita errores de consola si no corriste
# `php artisan reverb:start` localmente).
VITE_REVERB_FORCE_LOCAL=true

# ── Redis (requerido: el store 'database' no soporta tags, y
# CacheTenancyBootstrapper de stancl/tenancy fuerza tags en toda llamada
# Cache:: mientras hay un tenant activo — ver App\Support\TenantModuleResolver) ─
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Obtener API key en: https://resend.com/api-keys
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@artdent.com.ar"
MAIL_FROM_NAME="ArtDent - Insumos Odontológicos"
RESEND_API_KEY=re_V1FvmnEp_NESneVzRGHBRjGQekML3WToM

# ── AWS S3 (opcional) ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# ACCESS TOKEN de producción — obtener en: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=TEST-4821707163250763-100418-d305763b14a85432cf7c73230543b23c-240642664

# ── E-commerce ────────────────────────────────────────────────────────────────
ECOMMERCE_COMPANY_ID=1
ECOMMERCE_WAREHOUSE_ID=1

# ── Kiosk de fichaje (módulo Lab) ──────────────────────────────────────────────
LAB_ALLOWED_IPS=127.0.0.1,::1
# Sólo desarrollo local: a qué tenant resuelve el fallback de arriba cuando
# no hay ninguna KioskNetwork configurada en la BD para esa IP/token.
# KIOSK_DEFAULT_TENANT_ID=

VITE_APP_NAME="${APP_NAME}"

# Social Auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=postmessage

FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://shop.artdent.com.ar

# Chatbot AI
CHATBOT_PROVIDER=openai
CHATBOT_OPENAI_API_KEY=
CHATBOT_OPENAI_MODEL=gpt-5.4-nano
CHATBOT_OPENAI_PROMPT_CACHE_KEY=artdent:chatbot:erp:v1
CHATBOT_OPENAI_PROMPT_CACHE_RETENTION=in_memory

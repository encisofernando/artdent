{
  "name": "artdent-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",

# Puerto TCP donde el listener espera que los terminales se registren vía
# ISUP (Configuración → Red → Plataforma de acceso → ISUP, en cada terminal).
# 7660 es el default que trae la UI de los terminales Hikvision.
ISUP_LISTEN_PORT=7660
ISUP_LISTEN_IP=0.0.0.0

# Carpeta con libHCISUPCMS.so / libHCISUPAlarm.so (HCISUPSDK — el SDK
# específico de EHome/ISUP, distinto del Device Network SDK genérico). Ver
# README.md. Dejar vacío (o ISUP_MOCK=1 abajo) para correr en modo mock.
#
# IMPORTANTE: NO hace falta (ni conviene) setear LD_LIBRARY_PATH apuntando acá.
# Los .so de esta carpeta tienen que tener RPATH=$ORIGIN embebido (con
# `patchelf --set-rpath '$ORIGIN' *.so` dentro de la carpeta) para que
# resuelvan sus propias dependencias (libcrypto/libssl 1.0.0 propias, viejas)
# SIN contaminar el LD_LIBRARY_PATH de todo el proceso — si Node necesita su
# propio OpenSSL (por ejemplo al hacer fetch() a una URL https) con
# LD_LIBRARY_PATH apuntando acá, los símbolos de la libssl vieja del SDK
# pueden interponerse y crashear el proceso con SIGSEGV. Por eso además el
# SDK real corre en un proceso hijo aislado (ver sdkWorker.js) — nunca en el
# mismo proceso que hace fetch()/HTTPS a Laravel.
HCISUPSDK_LIB_DIR=/opt/hcisupsdk/lib

# EHome5.0: clave de cifrado que el SERVIDOR elige (no Hikvision) — tiene que
# cargarse idéntica en el terminal (Configuración → Red → Plataforma de
# acceso → ISUP → Encryption Key). 8-16 caracteres según la UI del terminal.
ISUP_EHOME_KEY=cambiar-por-una-clave-de-8-a-16-caracteres

# IP pública de este VPS — se usa para responder el paso de redirección DAS
# del handshake EHome5.0 (ENUM_DEV_DAS_REQ). Sin esto bien seteado el
# terminal se queda reintentando el login en loop sin completar el registro.
ISUP_SERVER_PUBLIC_IP=203.0.113.10

# Laravel (artdent-crm) — sólo localhost, nunca exponer estas rutas afuera.
LARAVEL_BASE_URL=http://127.0.0.1:8000
LARAVEL_INTERNAL_TOKEN=cambiar-por-un-token-largo-y-random

# Cola de reintentos en disco (eventos que no se pudieron mandar a Laravel).
RETRY_QUEUE_PATH=./data/retry-queue.jsonl
RETRY_INTERVAL_MS=5000

LOG_LEVEL=info

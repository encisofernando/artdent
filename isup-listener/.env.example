# Puerto TCP donde el listener espera que los terminales se registren vía
# ISUP (Configuración → Red → Plataforma de acceso → ISUP, en cada terminal).
# 7660 es el default que trae la UI de los terminales Hikvision.
ISUP_LISTEN_PORT=7660
ISUP_LISTEN_IP=0.0.0.0

# Carpeta con libHCISUPCMS.so / libHCISUPAlarm.so (HCISUPSDK — el SDK
# específico de EHome/ISUP, distinto del Device Network SDK genérico). Ver
# README.md. Dejar vacío (o ISUP_MOCK=1 abajo) para correr en modo mock.
HCISUPSDK_LIB_DIR=/opt/hcisupsdk/lib

# libHCISUPCMS.so/libHCISUPAlarm.so cargan en runtime otras .so del mismo
# paquete (libcrypto/libssl 1.0.0 propias, libz, libhpr, etc, todas bundladas
# en la misma carpeta) — tienen que estar en el LD_LIBRARY_PATH para que el
# dlopen interno del SDK las encuentre. No mezclar con las libs del HCNetSDK
# genérico (son versiones de OpenSSL distintas).
LD_LIBRARY_PATH=/opt/hcisupsdk/lib

# Laravel (artdent-crm) — sólo localhost, nunca exponer estas rutas afuera.
LARAVEL_BASE_URL=http://127.0.0.1:8000
LARAVEL_INTERNAL_TOKEN=cambiar-por-un-token-largo-y-random

# Cola de reintentos en disco (eventos que no se pudieron mandar a Laravel).
RETRY_QUEUE_PATH=./data/retry-queue.jsonl
RETRY_INTERVAL_MS=5000

LOG_LEVEL=info

# --- Carpetas/archivos personales de trabajo, nunca al repo ---
# (dumps SQL con datos reales, recibos/comprobantes personales, credenciales
# de prueba, documentos sueltos que no son parte del código del proyecto)
/Nueva carpeta/
/artdent_admin.sql
/artdent_dev.sql
/.codex
/ArtDent*.pdf
/token-panel.txt
/config
/artdent-panel/_extracted/
/artdent.sql
/9980248.pdf

# --- Backups de .env con secretos reales (cualquier variante, no solo .env.backup) ---
*.env.bak*
**/.env.bak*

# --- Storage de tenants (archivos subidos por negocios reales: logos, hero slides, etc.) ---
artdent-crm/storage/tenant*/app/public/

